{
  "name": "dom-native",
  "version": "0.13.0-WIP",
  "description": "A Native Web Component TypeScript Optimized Utility (zero dependency, < 20kb min, < 7kb gzip)",
  "author": "Jeremy Chone <jeremy.chone@gmail.com> (http://jeremychone.com)",
  "license": "MIT OR Apache-2.0",

  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",

  "scripts": {
    "prepack": "npm run build",
    "build": "rolldown -c",
    "watch": "rolldown -c -w",
    "build-min": "rolldown -c rolldown.min.config.js"
  },
  "devDependencies": {
    "rolldown": "^1.2.0",
    "typescript": "^7.0.0"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/dom-native/dom-native.git"
  },
  "keywords": [
    "domnative",
    "dom native",
    "frameworkless",
    "framework",
    "Web Components",
    "Native Web Components",
    "customElements",
    "cssGrid",
    "DOM",
    "mvc",
    "html5"
  ]
}
